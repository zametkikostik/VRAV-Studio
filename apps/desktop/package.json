{
  "name": "vrav-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "description": "VRAV Studio Desktop",
  "scripts": {
    "dev": "electron .",
    "pack:win": "electron-builder --win --config electron-builder.yml",
