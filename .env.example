# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_HOST=0.0.0.0
API_PORT=8000

# --- Database & cache ---
DATABASE_URL=postgresql+asyncpg://vrav:vrav@localhost:5432/vrav
DATABASE_URL_SYNC=postgresql://vrav:vrav@localhost:5432/vrav
REDIS_URL=redis://localhost:6379/0

# --- Frontend (also set in apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI providers (BYOK / VRAV Cloud) ---
XAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://api.routerai.ru/v1

# --- Payments (sandbox defaults; no real charges in CI) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_USE_SDK=0
STRIPE_ALLOW_LIVE=0
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_LIVE=0

# --- Billing safety ---
ALLOW_MANUAL_CREDIT_TOPUP=false
MAX_UPLOAD_BYTES=524288000

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vrav

# --- Email (password reset) ---
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@vrav.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
RESEND_API_KEY=
PASSWORD_RESET_URL=https://app.example.com/reset

# --- Rate limit / proxy ---
RATE_LIMIT_BACKEND=auto
AUTH_RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY_HEADERS=false
TRUSTED_PROXIES=127.0.0.1

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- GDPR ---
GDPR_RETENTION_DAYS=30
