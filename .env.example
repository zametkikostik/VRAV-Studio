# Copy to .env and fill values. Never commit real secrets.

SECRET_KEY=change-me-in-production
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://vrav:vrav@localhost:5432/vrav
REDIS_URL=redis://localhost:6379/0
LOCAL_STORAGE_PATH=./data/storage

# Billing (sandbox)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Transcription / Live ASR (server-side only)
TRANSCRIPTION_PROVIDER=mock
# TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=
# TRANSCRIPTION_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
ASR_TIMEOUT_SECONDS=120
ASR_MAX_RETRIES=2
# ASR_MAX_AUDIO_DURATION_SECONDS=3600
